# Zentrac website + quote dashboard environment variables — names and descriptions only. No credentials here.
# Copy to .env.local for local development. Server-only values must never use a NEXT_PUBLIC_ prefix.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Verified production origin, e.g. https://www.example.com (no trailing slash).
# Drives canonical URLs, hreflang alternates, sitemap and Open Graph URLs.
# Leave unset locally: the site then uses http://localhost:3000 and marks the build as non-production.
SITE_URL=

# Form delivery mode:
#   preview     -> visibly test-only. Validates input, sends and stores nothing.
#   live        -> quote requests, partner enquiries and career applications are stored in the
#                  dashboard database (needs DATABASE_URL, or DATABASE_DRIVER=pglite locally).
#                  Without a database every form fails closed ("unavailable").
#   (unset)     -> online submission unavailable.
# The owner can pause the partner and careers forms in the dashboard (Settings → Website forms).
FORM_MODE=preview

# Public contact channels (email, phone, WhatsApp, LinkedIn) are edited by the owner in the
# dashboard (Settings → Public contact details); there are no environment variables for them.
# The approved privacy policy version is part of the code (src/lib/legal.ts).

# Private review build only (npm run dev:review). Never set in a public build.
ZENTRAC_REVIEW=

# ---------------------------------------------------------------------------
# Dashboard database
# ---------------------------------------------------------------------------
# Production: a managed PostgreSQL connection string (postgres://user:password@host:5432/db?sslmode=require).
# Apply the schema with `npm run db:migrate` before starting the app.
DATABASE_URL=
DATABASE_POOL_MAX=10
# Local development / tests only: embedded PostgreSQL (PGlite) when DATABASE_URL is empty.
#   DATABASE_DRIVER=pglite and PGLITE_DATA_DIR=.data/pglite (one process at a time), or "memory".
DATABASE_DRIVER=
PGLITE_DATA_DIR=

# ---------------------------------------------------------------------------
# Authentication (Better Auth)
# ---------------------------------------------------------------------------
# Random secret, at least 32 characters (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`).
# Required in production: without it the dashboard stays closed. Rotating it signs everyone out
# and invalidates pending file links and two-factor enrolments in progress.
BETTER_AUTH_SECRET=
# Public origin of the dashboard (https in production; cookies become Secure automatically).
BETTER_AUTH_URL=
# Sign-in / verification attempts per 5 minutes per client (default 10). Raise only on isolated test servers.
AUTH_RATE_LIMIT_MAX=

# ---------------------------------------------------------------------------
# Private files
# ---------------------------------------------------------------------------
# database (default): files stored privately in the database. filesystem: under PRIVATE_STORAGE_DIR
# (must be a persistent volume outside the web root).
STORAGE_DRIVER=
PRIVATE_STORAGE_DIR=
# Malware scanning: leave empty when no scanner is configured (files then need a deliberate release
# by an owner/manager). "test" is a LOCAL TEST scanner that only detects the EICAR test string.
FILE_SCAN_MODE=

# ---------------------------------------------------------------------------
# Email (client messages and optional staff notifications)
# ---------------------------------------------------------------------------
#   (unset)/none -> nothing is sent; staff copy drafts or record offline sends.
#   outbox       -> LOCAL TEST outbox: messages are written to OUTBOX_DIR and delivered to no one.
#   smtp         -> real SMTP provider (requires SMTP_HOST and SMTP_FROM).
EMAIL_TRANSPORT=
OUTBOX_DIR=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Verified sender address/domain, e.g. "Zentrac <quotes@example.com>".
SMTP_FROM=

# ---------------------------------------------------------------------------
# Background jobs
# ---------------------------------------------------------------------------
# Built-in scheduler inside the Node.js server (notifications and clean-up every 5 minutes,
# retention daily). Default: on in production when a database is configured.
#   internal | off   (use "off" when an external scheduler calls POST /api/jobs/run instead)
JOBS_SCHEDULER=
# Token (>= 32 characters) for an external scheduler calling POST /api/jobs/run.
# Leave empty to disable the endpoint; `npm run jobs:run` works from the server console.
JOBS_RUNNER_TOKEN=

# ---------------------------------------------------------------------------
# Rate limits for the public forms (per client, per 10 minutes). Shared across server instances
# through the database in live mode; process-local in preview mode.
# ---------------------------------------------------------------------------
ENQUIRY_RATE_LIMIT=
UPLOAD_RATE_LIMIT=
