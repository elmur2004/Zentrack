{
  "name": "zentrac-website",
  "version": "1.0.0",
  "private": true,
  "description": "Zentrac bilingual (English/Arabic) engineering and BIM consultancy website",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:review": "node scripts/run-review.mjs dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:review": "playwright test --config tests/review/playwright.review.config.ts",
    "check:locales": "tsx scripts/check-locales.ts",
    "check:content": "tsx scripts/check-content.ts",
    "check:release": "tsx scripts/check-output.ts --release",
    "check:output": "tsx scripts/check-output.ts",
    "content:project": "tsx scripts/project-public-content.ts",
    "fonts": "node scripts/copy-fonts.mjs",
    "verify": "npm run check:locales && npm run check:content && npm run lint && npm run typecheck && npm run test && npm run build && npm run check:output",
    "test:admin": "playwright test --config tests/admin/playwright.admin.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/db-migrate.ts",
    "db:seed:test": "tsx --env-file-if-exists=.env.local scripts/db-seed-test.ts",
    "admin:create-owner": "tsx --env-file-if-exists=.env.local scripts/admin-create-owner.ts",
    "jobs:run": "tsx --env-file-if-exists=.env.local scripts/jobs-run.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.12",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "gsap": "3.15.0",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/saira": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
